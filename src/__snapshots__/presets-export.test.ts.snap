exports[`preset scripts > exports the vacuum_then_mop preset 1`] = `
"alias: Qrevo Curv 2 Flow Vac followed by Mop
description: "Runs the \\"Vac followed by Mop\\" preset of the Roborock Vacuum Map Card. Generated by the card; create it again after changing the preset."
icon: "mdi:vacuum-outline"
mode: single
fields:
  floor:
    name: Floor
    required: true
    default: downstairs
    selector:
      select:
        options:
        - value: downstairs
          label: Downstairs
        - value: upstairs
          label: Upstairs
variables:
  floors:
    downstairs:
      option: Downstairs
      routine: button.downstairs_vacmop
      areas:
      - kitchen
      - hallway
      - living_room
      whole_map: true
      segments:
        kitchen: 1
        hallway: 2
        living_room: 4
    upstairs:
      option: Upstairs
      routine: button.upstairs_vacmop
      areas:
      - office
      - overloop
      - bedroom
      - waskamer
      whole_map: true
      segments:
        office: 1
        overloop: 2
        bedroom: 3
        waskamer: 4
  info: "{{ floors[floor] }}"
sequence:
- alias: Select the floor map
  if:
  - "{{ info.option != '' and not is_state('select.map', info.option) }}"
  then:
  - action: select.select_option
    target:
      entity_id: select.map
    data:
      option: "{{ info.option }}"
  - wait_template: "{{ is_state('select.map', info.option) }}"
    timeout: "00:01:30"
    continue_on_timeout: true
  - if:
    - "{{ not wait.completed }}"
    then:
    - stop: The floor map did not become active.
      error: true
- if:
  - "{{ info.routine == '' }}"
  then:
  - stop: This floor has no Vac followed by Mop routine.
    error: true
- alias: Run the saved Roborock routine
  action: button.press
  target:
    entity_id: "{{ info.routine }}"
"
`;
