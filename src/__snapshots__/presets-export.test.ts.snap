// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`preset scripts > exports the smartplan preset 1`] = `
"alias: Qrevo Curv 2 Flow SmartPlan
description: "Runs the \\"SmartPlan\\" preset of the Roborock Vacuum Map Card. Generated by the card; create it again after changing the preset."
icon: "mdi:creation"
mode: single
fields:
  floor:
    name: Floor
    required: true
    default: downstairs
    selector:
      select:
        options:
        - value: downstairs
          label: Downstairs
        - value: upstairs
          label: Upstairs
  areas:
    name: Areas
    description: Leave empty to clean the whole floor.
    required: false
    selector:
      area:
        multiple: true
variables:
  floors:
    downstairs:
      option: Downstairs
      routine: button.downstairs_vacmop
      areas:
      - kitchen
      - hallway
      - living_room
      whole_map: true
      segments:
        kitchen: 1
        hallway: 2
        living_room: 4
    upstairs:
      option: Upstairs
      routine: button.upstairs_vacmop
      areas:
      - office
      - overloop
      - bedroom
      - waskamer
      whole_map: true
      segments:
        office: 1
        overloop: 2
        bedroom: 3
        waskamer: 4
  info: "{{ floors[floor] }}"
  whole_floor: "{{ not areas }}"
  target_areas: "{{ areas if areas else info.areas }}"
sequence:
- alias: Select the floor map
  if:
  - "{{ info.option != '' and not is_state('select.map', info.option) }}"
  then:
  - action: select.select_option
    target:
      entity_id: select.map
    data:
      option: "{{ info.option }}"
  - wait_template: "{{ is_state('select.map', info.option) }}"
    timeout: "00:01:30"
    continue_on_timeout: true
  - if:
    - "{{ not wait.completed }}"
    then:
    - stop: The floor map did not become active.
      error: true
- alias: AI SmartPlan
  action: vacuum.send_command
  target:
    entity_id: vacuum.roborock
  data:
    command: set_clean_motor_mode
    params:
    - fan_power: 110
      water_box_mode: 209
      mop_mode: 306
- alias: Cleaning count
  action: vacuum.send_command
  target:
    entity_id: vacuum.roborock
  data:
    command: set_clean_repeat_times
    params:
      repeat: 1
- alias: Start cleaning
  choose:
  - conditions:
    - "{{ whole_floor and info.whole_map }}"
    sequence:
    - action: vacuum.start
      target:
        entity_id: vacuum.roborock
  - conditions:
    - "{{ true }}"
    sequence:
    - action: vacuum.clean_area
      target:
        entity_id: vacuum.roborock
      data:
        cleaning_area_id: "{{ target_areas }}"
"
`;

exports[`preset scripts > exports the vacuum_and_mop preset 1`] = `
"alias: "Qrevo Curv 2 Flow Vac & Mop"
description: "Runs the \\"Vac & Mop\\" preset of the Roborock Vacuum Map Card. Generated by the card; create it again after changing the preset."
icon: "mdi:water-plus"
mode: single
fields:
  floor:
    name: Floor
    required: true
    default: downstairs
    selector:
      select:
        options:
        - value: downstairs
          label: Downstairs
        - value: upstairs
          label: Upstairs
  areas:
    name: Areas
    description: Leave empty to clean the whole floor.
    required: false
    selector:
      area:
        multiple: true
variables:
  floors:
    downstairs:
      option: Downstairs
      routine: button.downstairs_vacmop
      areas:
      - kitchen
      - hallway
      - living_room
      whole_map: true
      segments:
        kitchen: 1
        hallway: 2
        living_room: 4
    upstairs:
      option: Upstairs
      routine: button.upstairs_vacmop
      areas:
      - office
      - overloop
      - bedroom
      - waskamer
      whole_map: true
      segments:
        office: 1
        overloop: 2
        bedroom: 3
        waskamer: 4
  info: "{{ floors[floor] }}"
  whole_floor: "{{ not areas }}"
  target_areas: "{{ areas if areas else info.areas }}"
sequence:
- alias: Select the floor map
  if:
  - "{{ info.option != '' and not is_state('select.map', info.option) }}"
  then:
  - action: select.select_option
    target:
      entity_id: select.map
    data:
      option: "{{ info.option }}"
  - wait_template: "{{ is_state('select.map', info.option) }}"
    timeout: "00:01:30"
    continue_on_timeout: true
  - if:
    - "{{ not wait.completed }}"
    then:
    - stop: The floor map did not become active.
      error: true
- alias: Cleaning mode
  action: select.select_option
  target:
    entity_id: select.cleaning_mode
  data:
    option: vac_and_mop
- alias: Leave SmartPlan routes
  if:
  - condition: state
    entity_id: select.mop_mode
    state: smart_mode
  then:
  - action: select.select_option
    target:
      entity_id: select.mop_mode
    data:
      option: custom
- alias: Mop route
  action: select.select_option
  target:
    entity_id: select.mop_mode
  data:
    option: standard
- alias: Water flow
  action: select.select_option
  target:
    entity_id: select.mop_intensity
  data:
    option: medium
- alias: Suction
  action: vacuum.set_fan_speed
  target:
    entity_id: vacuum.roborock
  data:
    fan_speed: balanced
- alias: Cleaning count
  action: vacuum.send_command
  target:
    entity_id: vacuum.roborock
  data:
    command: set_clean_repeat_times
    params:
      repeat: 1
- alias: Start cleaning
  choose:
  - conditions:
    - "{{ whole_floor and info.whole_map }}"
    sequence:
    - action: vacuum.start
      target:
        entity_id: vacuum.roborock
  - conditions:
    - "{{ true }}"
    sequence:
    - action: vacuum.clean_area
      target:
        entity_id: vacuum.roborock
      data:
        cleaning_area_id: "{{ target_areas }}"
"
`;

